# Base de datos PostgreSQL / Supabase
PGHOST=db.<project-ref>.supabase.co
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=cambiar_por_password_real
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:6543/postgres

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_string_aleatorio_64_chars
JWT_EXPIRES_IN=8h

# Seguridad
BCRYPT_SALT_ROUNDS=12

# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# API de Gemini (Google AI Studio)
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# Límites IA
IA_MAX_PREGUNTAS_POR_SOLICITUD=10
IA_MAX_SOLICITUDES_POR_DIA=50
