# ═══════════════════════════════════════════════════════════════════════
#  PreparIA — Plantilla de variables de entorno
#  Copia este archivo como .env y completa los valores.
#      Windows:  copy .env.example .env
#      Linux/Mac: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── 1. BASE DE DATOS ──────────────────────────────────────────────────
# Elige UNA de las dos opciones.

# Opción A — PostgreSQL instalado en tu computador (lo más común para evaluar)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prepardb
DB_USER=preparia_user
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# Opción B — Servicio en la nube (Supabase, Neon, Render…). Si defines
# DATABASE_URL, tiene prioridad sobre las variables de arriba.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
# DB_SSL=true

# Nota: si no defines DB_SSL, el sistema lo decide solo — lo desactiva
# para localhost y lo activa para cualquier host remoto.


# ── 2. SEGURIDAD ──────────────────────────────────────────────────────
# Genera un valor propio con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
JWT_EXPIRES_IN=8h

# Rondas de hashing de contraseñas (bcrypt)
BCRYPT_SALT_ROUNDS=12

# Minutos de inactividad antes de cerrar la sesión (NFR de seguridad)
SESSION_IDLE_MINUTES=30


# ── 3. SERVIDOR ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Orígenes permitidos para el frontend, separados por comas.
# 5500 es el puerto que usa la extensión Live Server de VS Code.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_URL=


# ── 4. INTELIGENCIA ARTIFICIAL (Google Gemini) ────────────────────────
# Sin esta clave el proyecto arranca, pero el simulador no genera preguntas.
# Se obtiene gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# Límites de uso de la IA
IA_MAX_PREGUNTAS_POR_SOLICITUD=10
IA_MAX_SOLICITUDES_POR_DIA=50


# ── 5. EXAMEN DE NIVELACIÓN (RF-06) ───────────────────────────────────
# Preguntas fijas por cada nivel y porcentaje mínimo para superarlo.
EXAMEN_NIVEL_POR_NIVEL=3
EXAMEN_NIVEL_UMBRAL=60
